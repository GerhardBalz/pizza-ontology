@prefix art: <urn:pizza-ontology:artifact:> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .

art:PizzaSemanticArtifactSet
    a dcat:Dataset, prov:Entity ;
    dcterms:title "Pizza semantic artifact set"@en ;
    dcterms:description "Repository-owned Pizza semantic artifacts intended for commit- or release-pinned downstream consumption. Relative identifiers are stable repository paths; consumers choose the immutable Git commit or preservation release that binds those paths to bytes."@en ;
    dcterms:relation <http://www.co-ode.org/ontologies/pizza> ;
    dcat:distribution
        art:SpicyPizzaReasoningModule,
        art:PizzaInstanceShapes,
        art:ConformingPizzaData,
        art:NonConformingPizzaData,
        art:PizzaVegetarianWarningRule,
        art:PizzaRuleVocabulary,
        art:PizzaRuleData,
        art:PizzaDietarySuitabilityDecision,
        art:PizzaDecisionVocabulary,
        art:PizzaDecisionCases,
        art:PizzaAreaCalculationFormula,
        art:PizzaCalculationVocabulary,
        art:PizzaCalculationCases .

art:SpicyPizzaReasoningModule
    a dcat:Distribution, prov:Entity ;
    dcterms:title "Pizza SpicyPizza coherent reasoning module"@en ;
    dcterms:description "Coherent OWL module derived from Pizza Ontology 2.0 for representative reasoning and explanation."@en ;
    dcterms:identifier "artifacts/reasoning/spicy-pizza.ofn" ;
    dcterms:format "application/owl-functional" ;
    dcterms:license <https://creativecommons.org/licenses/by/3.0/> ;
    prov:wasDerivedFrom art:Pizza2SourceBlob .

art:PizzaInstanceShapes
    a dcat:Distribution, prov:Entity ;
    dcterms:title "Pizza instance SHACL profile"@en ;
    dcterms:description "Repository-authored SHACL validation profile for explicit Pizza instance data."@en ;
    dcterms:identifier "artifacts/validation/pizza-instance-shapes.ttl" ;
    dcterms:format "text/turtle" ;
    dcterms:license <https://opensource.org/license/mit> ;
    dcterms:relation <http://www.co-ode.org/ontologies/pizza> .

art:ConformingPizzaData
    a dcat:Distribution, prov:Entity ;
    dcterms:title "Conforming Pizza validation data"@en ;
    dcterms:description "Repository-authored RDF example expected to conform to the Pizza instance SHACL profile."@en ;
    dcterms:identifier "artifacts/validation/data/conforming.ttl" ;
    dcterms:format "text/turtle" ;
    dcterms:license <https://opensource.org/license/mit> ;
    dcterms:conformsTo art:PizzaInstanceShapes .

art:NonConformingPizzaData
    a dcat:Distribution, prov:Entity ;
    dcterms:title "Non-conforming Pizza validation data"@en ;
    dcterms:description "Repository-authored RDF example intentionally expected not to conform to the Pizza instance SHACL profile."@en ;
    dcterms:identifier "artifacts/validation/data/non-conforming.ttl" ;
    dcterms:format "text/turtle" ;
    dcterms:license <https://opensource.org/license/mit> ;
    dcterms:relation art:PizzaInstanceShapes .

art:PizzaVegetarianWarningRule
    a dcat:Distribution, prov:Entity ;
    dcterms:title "Pizza vegetarian warning SPARQL rule"@en ;
    dcterms:description "Repository-authored SPARQL 1.1 CONSTRUCT rule that derives a vegetarian-warning result when explicit Pizza data references a topping typed as pizza:MeatTopping."@en ;
    dcterms:identifier "artifacts/rules/vegetarian-warning.rq" ;
    dcterms:format "application/sparql-query" ;
    dcterms:license <https://opensource.org/license/mit> ;
    dcterms:requires art:PizzaRuleVocabulary ;
    dcterms:relation <http://www.co-ode.org/ontologies/pizza> .

art:PizzaRuleVocabulary
    a dcat:Distribution, prov:Entity ;
    dcterms:title "Pizza rule result vocabulary"@en ;
    dcterms:description "Repository-authored RDF vocabulary defining the machine-readable result relation produced by the Pizza vegetarian warning rule."@en ;
    dcterms:identifier "artifacts/rules/rule-vocabulary.ttl" ;
    dcterms:format "text/turtle" ;
    dcterms:license <https://opensource.org/license/mit> ;
    dcterms:relation <http://www.co-ode.org/ontologies/pizza> .

art:PizzaRuleData
    a dcat:Distribution, prov:Entity ;
    dcterms:title "Pizza rule evaluation data"@en ;
    dcterms:description "Repository-authored RDF input containing a matching MeatTopping Pizza and a non-matching vegetable Pizza control case."@en ;
    dcterms:identifier "artifacts/rules/data/menu-pizzas.ttl" ;
    dcterms:format "text/turtle" ;
    dcterms:license <https://opensource.org/license/mit> ;
    dcterms:requires art:PizzaRuleVocabulary ;
    dcterms:relation <http://www.co-ode.org/ontologies/pizza> .

art:PizzaDietarySuitabilityDecision
    a dcat:Distribution, prov:Entity ;
    dcterms:title "Pizza dietary suitability DMN decision"@en ;
    dcterms:description "Repository-authored DMN 1.5 UNIQUE decision table that selects one dietary-suitability outcome from explicit containsMeat and containsFish decision inputs."@en ;
    dcterms:identifier "artifacts/decisions/pizza-dietary-suitability.dmn" ;
    dcterms:format "application/xml" ;
    dcterms:license <https://opensource.org/license/mit> ;
    dcterms:conformsTo <https://www.omg.org/spec/DMN/1.5/> ;
    dcterms:requires art:PizzaDecisionVocabulary ;
    dcterms:relation <http://www.co-ode.org/ontologies/pizza> .

art:PizzaDecisionVocabulary
    a dcat:Distribution, prov:Entity ;
    dcterms:title "Pizza decision outcome vocabulary"@en ;
    dcterms:description "Repository-authored RDF vocabulary defining the dietary-suitability result relation and semantic outcome identifiers used by the Pizza DMN decision."@en ;
    dcterms:identifier "artifacts/decisions/decision-vocabulary.ttl" ;
    dcterms:format "text/turtle" ;
    dcterms:license <https://opensource.org/license/mit> ;
    dcterms:relation <http://www.co-ode.org/ontologies/pizza> .

art:PizzaDecisionCases
    a dcat:Distribution, prov:Entity ;
    dcterms:title "Pizza dietary-suitability decision cases"@en ;
    dcterms:description "Repository-authored JSON decision-input cases exercising NotVegetarian, PescatarianOnly, and Vegetarian outcomes."@en ;
    dcterms:identifier "artifacts/decisions/data/cases.json" ;
    dcterms:format "application/json" ;
    dcterms:license <https://opensource.org/license/mit> ;
    dcterms:requires art:PizzaDietarySuitabilityDecision, art:PizzaDecisionVocabulary .

art:PizzaAreaCalculationFormula
    a dcat:Distribution, prov:Entity ;
    dcterms:title "Pizza circular-area OpenMath formula"@en ;
    dcterms:description "Repository-authored OpenMath formula calculating circular Pizza area as pi times the square of half the diameter."@en ;
    dcterms:identifier "artifacts/calculations/pizza-area.openmath.xml" ;
    dcterms:format "application/xml" ;
    dcterms:license <https://opensource.org/license/mit> ;
    dcterms:conformsTo <https://openmath.org/standard/om20-2019-07-01/omstd20.html> ;
    dcterms:requires art:PizzaCalculationVocabulary ;
    dcterms:relation <http://www.co-ode.org/ontologies/pizza> .

art:PizzaCalculationVocabulary
    a dcat:Distribution, prov:Entity ;
    dcterms:title "Pizza calculation vocabulary"@en ;
    dcterms:description "Repository-authored RDF vocabulary grounding the OpenMath diameter input and area result in centimetres and square centimetres."@en ;
    dcterms:identifier "artifacts/calculations/calculation-vocabulary.ttl" ;
    dcterms:format "text/turtle" ;
    dcterms:license <https://opensource.org/license/mit> ;
    dcterms:relation <http://www.co-ode.org/ontologies/pizza> .

art:PizzaCalculationCases
    a dcat:Distribution, prov:Entity ;
    dcterms:title "Pizza area calculation cases"@en ;
    dcterms:description "Repository-authored JSON diameter inputs and expected square-centimetre area results for the canonical Pizza OpenMath calculation."@en ;
    dcterms:identifier "artifacts/calculations/data/cases.json" ;
    dcterms:format "application/json" ;
    dcterms:license <https://opensource.org/license/mit> ;
    dcterms:requires art:PizzaAreaCalculationFormula, art:PizzaCalculationVocabulary .

art:Pizza2SourceBlob
    a prov:Entity ;
    dcterms:title "Preserved Pizza Ontology 2.0 source snapshot"@en ;
    dcterms:identifier "git-blob:397492e484de5560f8a7e048ce8999b707d94388" ;
    dcterms:license <https://creativecommons.org/licenses/by/3.0/> ;
    dcterms:source <https://github.com/GerhardBalz/pizza-ontology/blob/079e80da896315483cad611dd0f3439449dfa722/src/ontology/pizza-edit.owl> .
