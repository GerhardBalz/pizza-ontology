@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rule: <urn:pizza-ontology:rule:> .

rule:requiresVegetarianWarning
    a rdf:Property ;
    rdfs:label "requires vegetarian warning"@en ;
    dcterms:description "Boolean rule result indicating that a Pizza has at least one explicitly asserted topping typed as pizza:MeatTopping and therefore requires a vegetarian warning in this reference rule profile."@en ;
    dcterms:license <https://opensource.org/license/mit> .
