@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix decision: <urn:pizza-ontology:decision:> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<urn:pizza-ontology:decision:vocabulary>
    a owl:Ontology ;
    dcterms:title "Pizza dietary suitability decision vocabulary"@en ;
    dcterms:description "Repository-authored vocabulary for the semantic relation and outcomes produced by the Pizza dietary-suitability decision model."@en ;
    dcterms:license <https://opensource.org/license/mit> .

decision:DietarySuitabilityOutcome
    a owl:Class ;
    rdfs:label "Dietary Suitability Outcome"@en .

decision:dietarySuitability
    a owl:ObjectProperty ;
    rdfs:label "dietary suitability"@en ;
    rdfs:range decision:DietarySuitabilityOutcome .

decision:NotVegetarian
    a decision:DietarySuitabilityOutcome ;
    rdfs:label "Not vegetarian"@en ;
    skos:definition "The Pizza is not suitable for a vegetarian diet because the decision input states that it contains meat."@en .

decision:PescatarianOnly
    a decision:DietarySuitabilityOutcome ;
    rdfs:label "Pescatarian only"@en ;
    skos:definition "The Pizza is not vegetarian but is compatible with the decision model's pescatarian category because it contains fish and no meat."@en .

decision:Vegetarian
    a decision:DietarySuitabilityOutcome ;
    rdfs:label "Vegetarian"@en ;
    skos:definition "The Pizza is classified by the decision model as vegetarian because the supplied decision inputs state that it contains neither meat nor fish."@en .
