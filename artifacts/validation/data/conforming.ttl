@prefix ex: <urn:pizza-ontology:validation:example:> .
@prefix pizza: <http://www.co-ode.org/ontologies/pizza/pizza.owl#> .

ex:validPizza
    a pizza:Pizza ;
    pizza:hasBase ex:thinBase ;
    pizza:hasTopping ex:jalapenoTopping .

ex:thinBase
    a pizza:PizzaBase .

ex:jalapenoTopping
    a pizza:PizzaTopping,
      pizza:JalapenoPepperTopping .
