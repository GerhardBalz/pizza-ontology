{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Pizza Concept API",
    "version": "1.0.0",
    "description": "Application-facing OpenAPI projection of selected Pizza Ontology 2.0 semantics. The API contract is not the ontology and does not replace the preserved semantic source."
  },
  "tags": [
    {
      "name": "Pizza concepts",
      "description": "Read-only access to the selected source-verified Pizza concept projection."
    }
  ],
  "x-pizza-projection": {
    "projection": {
      "id": "urn:pizza-ontology:projection:pizza-concepts-openapi:v1",
      "type": "OpenApiImplementationProjection",
      "version": "1.0.0"
    },
    "sourceSemanticModel": {
      "ontologyIri": "http://www.co-ode.org/ontologies/pizza",
      "versionIri": "http://www.co-ode.org/ontologies/pizza/2.0.0",
      "entityNamespace": "http://www.co-ode.org/ontologies/pizza/pizza.owl#",
      "repositoryPath": "src/ontology/pizza-edit.owl",
      "accessLayer": "OAK graph projection"
    },
    "sourceSelectionConfig": "../pizza-concepts/projection-config.json",
    "selectedSourceConceptIds": [
      "pizza:AmericanHot",
      "pizza:Margherita"
    ],
    "projectionPolicy": {
      "preserved": [
        "historical Pizza entity IRIs",
        "selected asserted named superclass relationships",
        "selected hasTopping existential relationship targets"
      ],
      "transformed": [
        "OWL class identifiers are exposed as CURIE plus full IRI",
        "selected OWL relationships are represented as OpenAPI response-schema fields",
        "OWL hasTopping existential restrictions are flattened to requiredToppings references"
      ],
      "introduced": [
        "displayLabel is an application-facing choice from the shared projection selection config",
        "HTTP paths, GET operations, query parameters, status codes, response envelopes, and error schema are API-contract concerns",
        "OpenAPI and JSON Schema structures describe an implementation interface rather than ontology axioms"
      ],
      "omitted": [
        "universal topping closure restrictions",
        "country-of-origin restrictions",
        "inferred classifications",
        "disjointness axioms",
        "object-property characteristics and broader OWL axioms",
        "ontology annotations not required by this projection",
        "runtime deployment location and server bindings"
      ]
    }
  },
  "paths": {
    "/concepts": {
      "get": {
        "operationId": "listPizzaConcepts",
        "summary": "List projected Pizza concepts",
        "tags": [
          "Pizza concepts"
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Application-level text filter over projected labels and identifiers.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "requiredTopping",
            "in": "query",
            "required": false,
            "description": "Filter by a projected hasTopping some X existential requirement. This does not mean the topping list is closed.",
            "schema": {
              "$ref": "#/components/schemas/ToppingId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Projected Pizza concepts matching the API-level filters.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PizzaConceptCollection"
                }
              }
            }
          }
        }
      }
    },
    "/concepts/{conceptId}": {
      "get": {
        "operationId": "getPizzaConcept",
        "summary": "Get one projected Pizza concept",
        "tags": [
          "Pizza concepts"
        ],
        "parameters": [
          {
            "name": "conceptId",
            "in": "path",
            "required": true,
            "description": "CURIE of a concept included in this selected projection.",
            "schema": {
              "$ref": "#/components/schemas/PizzaConceptId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One source-backed projected Pizza concept.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PizzaConcept"
                }
              }
            }
          },
          "404": {
            "description": "The requested concept is not present in this selected API projection.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PizzaConceptId": {
        "type": "string",
        "description": "CURIE of a Pizza class selected for this implementation projection.",
        "enum": [
          "pizza:AmericanHot",
          "pizza:Margherita"
        ]
      },
      "ToppingId": {
        "type": "string",
        "description": "CURIE of a topping appearing in a projected existential requirement.",
        "enum": [
          "pizza:HotGreenPepperTopping",
          "pizza:JalapenoPepperTopping",
          "pizza:MozzarellaTopping",
          "pizza:PeperoniSausageTopping",
          "pizza:TomatoTopping"
        ]
      },
      "SemanticReference": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "iri"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^pizza:",
            "description": "Compact Pizza identifier used by the implementation contract."
          },
          "iri": {
            "type": "string",
            "format": "uri",
            "description": "Historical Pizza entity IRI; this remains the semantic identity."
          }
        }
      },
      "Traceability": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceEntityIri",
          "superclassSemantics",
          "toppingSemantics"
        ],
        "properties": {
          "sourceEntityIri": {
            "type": "string",
            "format": "uri"
          },
          "superclassSemantics": {
            "type": "string"
          },
          "toppingSemantics": {
            "type": "string"
          }
        }
      },
      "PizzaConcept": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "iri",
          "displayLabel",
          "displayLabelSource",
          "directSuperClasses",
          "requiredToppings",
          "traceability"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/PizzaConceptId"
          },
          "iri": {
            "type": "string",
            "format": "uri",
            "description": "Historical Pizza entity IRI."
          },
          "displayLabel": {
            "type": "string",
            "minLength": 1,
            "description": "Application-facing label chosen by projection configuration."
          },
          "displayLabelSource": {
            "type": "string",
            "const": "projection-config"
          },
          "directSuperClasses": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/SemanticReference"
            },
            "description": "Selected asserted named superclass relationships projected from OWL."
          },
          "requiredToppings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/SemanticReference"
            },
            "description": "Targets of projected OWL hasTopping some X existential restrictions. This is not a closed recipe or complete allowed-topping list."
          },
          "traceability": {
            "$ref": "#/components/schemas/Traceability"
          }
        }
      },
      "PizzaConceptCollection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "count",
          "items"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PizzaConcept"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
