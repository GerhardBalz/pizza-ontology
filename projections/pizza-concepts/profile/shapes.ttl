@prefix dct: <http://purl.org/dc/terms/> .
@prefix eska: <https://w3id.org/eska#> .
@prefix prof: <http://www.w3.org/ns/dx/prof/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix pcp: <urn:pizza-ontology:projection-profile:pizza-concepts:v1#> .

pcp:ProfileShape
    a sh:NodeShape ;
    sh:targetNode <urn:pizza-ontology:profile:pizza-concepts-preservation:v1> ;
    sh:class prof:Profile ;
    sh:property [
        sh:path prof:hasResource ;
        sh:minCount 4 ;
        sh:message "The projection profile must expose its specification, preservation contract, representation schema, and SHACL validation resources."@en
    ] ;
    sh:property [
        sh:path prof:isProfileOf ;
        sh:maxCount 0 ;
        sh:message "This experiment uses a root PROF profile and must not force Pizza Ontology 2.0 into dcterms:Standard via prof:isProfileOf."@en
    ] .

pcp:SourceSemanticModelShape
    a sh:NodeShape ;
    sh:targetNode <http://www.co-ode.org/ontologies/pizza/2.0.0> ;
    sh:class eska:SemanticModel ;
    sh:class prov:Entity .

pcp:ProjectionClaimShape
    a sh:NodeShape ;
    sh:targetNode <urn:pizza-ontology:projection:pizza-concepts:v1> ;
    sh:class eska:Result ;
    sh:class prov:Entity ;
    sh:property [
        sh:path dct:conformsTo ;
        sh:hasValue <urn:pizza-ontology:profile:pizza-concepts-preservation:v1> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The projection must make exactly one explicit conformance claim to the tested projection/preservation profile."@en
    ] ;
    sh:property [
        sh:path prov:wasDerivedFrom ;
        sh:hasValue <http://www.co-ode.org/ontologies/pizza/2.0.0> ;
        sh:minCount 1 ;
        sh:message "The projection must retain provenance to the authoritative Pizza 2.0 semantic source."@en
    ] ;
    sh:property [
        sh:path prov:wasGeneratedBy ;
        sh:hasValue <urn:pizza-ontology:activity:pizza-concepts-projection:v1> ;
        sh:minCount 1
    ] .

pcp:ProjectionExecutionShape
    a sh:NodeShape ;
    sh:targetNode <urn:pizza-ontology:activity:pizza-concepts-projection:v1> ;
    sh:class eska:Execution ;
    sh:property [
        sh:path eska:usesSemanticModel ;
        sh:hasValue <http://www.co-ode.org/ontologies/pizza/2.0.0> ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path eska:generatesResult ;
        sh:hasValue <urn:pizza-ontology:projection:pizza-concepts:v1> ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path prov:used ;
        sh:hasValue <http://www.co-ode.org/ontologies/pizza/2.0.0> ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path prov:generated ;
        sh:hasValue <urn:pizza-ontology:projection:pizza-concepts:v1> ;
        sh:minCount 1
    ] .

pcp:ProjectionVerificationShape
    a sh:NodeShape ;
    sh:targetNode <urn:pizza-ontology:verification:pizza-concepts-profile:v1> ;
    sh:class eska:Verification ;
    sh:property [
        sh:path eska:verifiesExecution ;
        sh:hasValue <urn:pizza-ontology:activity:pizza-concepts-projection:v1> ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path eska:verifiesResult ;
        sh:hasValue <urn:pizza-ontology:projection:pizza-concepts:v1> ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path prov:used ;
        sh:hasValue <urn:pizza-ontology:projection:pizza-concepts:v1> ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path prov:used ;
        sh:hasValue <urn:pizza-ontology:profile:pizza-concepts-preservation:v1> ;
        sh:minCount 1
    ] .
