{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pizza-ontology:projection-schema:pizza-concepts:v1",
  "title": "Pizza concept semantic projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "projection",
    "sourceSemanticModel",
    "projectionPolicy",
    "concepts"
  ],
  "properties": {
    "$schema": {
      "const": "./projection.schema.json"
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"const": "PizzaConceptCatalog"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "sourceSemanticModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ontologyIri", "versionIri", "entityNamespace", "repositoryPath", "accessLayer"],
      "properties": {
        "ontologyIri": {"type": "string", "format": "uri"},
        "versionIri": {"type": "string", "format": "uri"},
        "entityNamespace": {"type": "string", "format": "uri"},
        "repositoryPath": {"const": "src/ontology/pizza-edit.owl"},
        "accessLayer": {"const": "OAK graph projection"}
      }
    },
    "projectionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preserved", "transformed", "introduced", "omitted"],
      "properties": {
        "preserved": {"$ref": "#/$defs/stringList"},
        "transformed": {"$ref": "#/$defs/stringList"},
        "introduced": {"$ref": "#/$defs/stringList"},
        "omitted": {"$ref": "#/$defs/stringList"}
      }
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/concept"}
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "entityReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "iri"],
      "properties": {
        "id": {"type": "string", "pattern": "^pizza:[A-Za-z0-9_]+$"},
        "iri": {"type": "string", "format": "uri"}
      }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "iri",
        "displayLabel",
        "displayLabelSource",
        "directSuperClasses",
        "requiredToppings",
        "traceability"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^pizza:[A-Za-z0-9_]+$"},
        "iri": {"type": "string", "format": "uri"},
        "displayLabel": {"type": "string", "minLength": 1},
        "displayLabelSource": {"const": "projection-config"},
        "directSuperClasses": {
          "type": "array",
          "items": {"$ref": "#/$defs/entityReference"},
          "uniqueItems": true
        },
        "requiredToppings": {
          "type": "array",
          "items": {"$ref": "#/$defs/entityReference"},
          "uniqueItems": true
        },
        "traceability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceEntityIri", "superclassSemantics", "toppingSemantics"],
          "properties": {
            "sourceEntityIri": {"type": "string", "format": "uri"},
            "superclassSemantics": {"const": "asserted named rdfs:subClassOf projected by OAK"},
            "toppingSemantics": {"const": "OWL hasTopping existential restrictions flattened by OAK graph projection"}
          }
        }
      }
    }
  }
}
